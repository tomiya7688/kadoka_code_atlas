{
  "name": "Contract Fixture",
  "trigger": ["push", "pull_request"],
  "jobs": [
    {
      "name": "test",
      "needs": [],
      "steps": [
        {
          "name": "Tests",
          "command": "python -m pytest tests/unit/test_service.py",
          "action": null,
          "path_hints": ["tests/unit/test_service.py"]
        }
      ]
    },
    {
      "name": "build",
      "needs": ["test"],
      "steps": [
        {
          "name": "Checkout",
          "command": null,
          "action": "actions/checkout@v4",
          "path_hints": []
        },
        {
          "name": "Build",
          "command": "python -m build",
          "action": null,
          "path_hints": []
        }
      ]
    }
  ]
}
